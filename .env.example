# Copy to .env and fill in values (do not commit .env)

# PostgreSQL (used by Airflow metadata DB and stock_data table)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow_db

# Airflow web UI (username is always "admin" in docker-compose)
AIRFLOW_ADMIN_PASSWORD=change_me

# Alpha Vantage — required for fetch script
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Comma-separated tickers (no spaces required; spaces are trimmed)
STOCK_SYMBOLS=MSFT,GOOGL,AAPL
